# Copy this file to .env and fill in real values.
# .env is gitignored — never commit credentials.
#
# ============================================================================
# WARNING: API_KEY_s is the Supabase SERVICE ROLE key. It bypasses Row Level
# Security and grants full read/write access to the production database and
# auth admin operations. Treat it like a root password:
#
#   - Never commit .env (gitignored, double-check before any `git add -A`).
#   - Never paste it into chat, screenshots, issues, or screen-share.
#   - Rotate immediately via the Supabase dashboard if it leaks.
# ============================================================================

# --- Required (FastAPI server + tests) ---
API_URL=https://your-project-id.supabase.co
API_KEY_s=your-supabase-service-role-key

# --- Optional server tunables ---
# HOST=0.0.0.0
# PORT=8000
# CORS_ORIGINS=                  # comma-separated additional CORS origins (Cloud Run URL, prod web domain)

# --- SUPER_ADMIN_EMAIL ---
# Email of the bootstrap superAdmin account. DELETE /users/{user_id} refuses
# to delete this address even when called by another superAdmin, so the
# bootstrap account can never be locked out. Required if a superAdmin
# delete-user endpoint may be exercised against the bootstrap account.
# SUPER_ADMIN_EMAIL=

# --- Integration test opt-in ---
# Default `pytest` runs unit tests only. Set this to "1" ONLY when you want
# pytest to create per-run UUID-namespaced test users + matches against the
# Supabase project that API_URL points at, and surgically delete them on
# teardown. Pointing this at prod is supported (the suite tracks every
# entity it creates and deletes only those), but treat it with care.
RUN_INTEGRATION_TESTS=0

# Password assigned to every per-run test user. Not a secret on its own —
# the namespaced test users are isolated per run.
# TEST_PASSWORD=TestPassword123!
